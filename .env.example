# MatchLens standalone deployment configuration
# Copy these variable names to the hosting provider's private environment settings.
# Never commit real credentials, user IDs or keys.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
MATCHLENS_ALLOWED_USER_ID=YOUR_SUPABASE_AUTH_USER_UUID
# Set NODE_ENV=production through the hosting build/runtime, not manually here.
